# Copy this file to .env and add your Anthropic API key.
ANTHROPIC_API_KEY=your_api_key_here

# PostgreSQL connection used by the backend.
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5433/jobpilot

# Optional. The default is a current Claude Sonnet model.
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Job Analysis requirement matcher. This is the only LLM step whose model was
# selected by a frozen evaluation. Set MATCHER_PROVIDER=qwen to route ONLY the
# Job Analysis matcher through Alibaba DashScope (OpenAI-compatible endpoint);
# every other LLM service always uses Claude. Leave as "anthropic" to keep the
# matcher on Claude too. DASHSCOPE_API_KEY is only needed when provider=qwen.
MATCHER_PROVIDER=anthropic
MATCHER_MODEL=qwen3.8-max
DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Comma-separated browser origins allowed to call the backend.
FRONTEND_ORIGINS=http://localhost:5173

# Frontend API base URL (used at frontend build/dev time).
VITE_API_BASE_URL=http://localhost:8000

# Safe public job-page retrieval limits.
JOB_FETCH_TIMEOUT_SECONDS=10
JOB_FETCH_MAX_BYTES=2097152
JOB_FETCH_MAX_REDIRECTS=3

# Phase 4 search-result import limits. These protect the upstream service and
# keep a single local import bounded; deterministic imports make no Claude calls.
JOB_IMPORT_PAGE_SIZE=100
JOB_IMPORT_MAX_JOBS=2000
JOB_IMPORT_MAX_PAGES=50
JOB_IMPORT_TIMEOUT_SECONDS=20
JOB_IMPORT_MAX_RESPONSE_BYTES=5242880
JOB_IMPORT_PAGE_DELAY_SECONDS=0.35
JOB_IMPORT_MAX_RETRIES=3

# Phase 7 ephemeral discovery limits. Results live only in backend memory and
# are never persisted to the jobs table until the user explicitly adds one.
DISCOVERY_TTL_MINUTES=60
DISCOVERY_MAX_SESSIONS=20
DISCOVERY_MAX_RESULTS=500
